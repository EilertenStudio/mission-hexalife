{
  "format_version": 1,
  "shortcut_prefix": {
    "keys": [
      "ctrl+p"
    ],
    "timeout": "until_next_key",
    "commands": {
      "m": "scene_select",
      "r": "scene_reload",
      "c": "frame_copy"
    }
  },
  "global_actions": {
    "scene_reload": {
      "type": "action",
      "label": "Ricarica scena",
      "shortcut": [
        "ctrl+p",
        "r"
      ]
    },
    "frame_copy": {
      "type": "action",
      "label": "Copia frame",
      "shortcut": [
        "ctrl+p",
        "c"
      ],
      "output": "clipboard_image/png"
    }
  },
  "menus": {
    "system_settings": {
      "scope": "system",
      "title": "System Settings",
      "shortcut": [
        "ctrl+p"
      ],
      "close_keys": [
        "escape"
      ],
      "items": [
        {
          "id": "scene_select",
          "type": "submenu",
          "label": "Cambia scena",
          "key": "m",
          "shortcut": [
            "ctrl+p",
            "m"
          ]
        },
        {
          "id": "scene_reload",
          "type": "action",
          "label": "Ricarica scena",
          "key": "r",
          "shortcut": [
            "ctrl+p",
            "r"
          ]
        },
        {
          "id": "frame_copy",
          "type": "action",
          "label": "Copia frame",
          "key": "c",
          "shortcut": [
            "ctrl+p",
            "c"
          ]
        }
      ]
    },
    "scene_select": {
      "scope": "system",
      "title": "Cambia scena",
      "close_keys": [
        "escape"
      ],
      "items": [
        {
          "id": "test-gameplay-rhythm-crypto",
          "type": "scene_option",
          "label": "Test gameplay rhythm crypto",
          "key": "1",
          "scene": "res://scenes/test-gameplay-rhythm-crypto.tscn"
        },
        {
          "id": "test-visual-2D-lighting",
          "type": "scene_option",
          "label": "Test visual 2D lighting",
          "key": "2",
          "scene": "res://scenes/test-visual-2D-lighting.tscn"
        }
      ]
    },
    "gameplay_prefix": {
      "scope": "scene",
      "title": "Debug Gameplay",
      "shortcut": [
        "ctrl+d"
      ],
      "close_keys": [
        "escape"
      ],
      "items": [
        {
          "id": "gameplay_menu",
          "type": "submenu",
          "label": "Gameplay",
          "key": "g",
          "shortcut": [
            "ctrl+d",
            "g"
          ]
        }
      ]
    },
    "gameplay_menu": {
      "scope": "scene",
      "title": "Gameplay",
      "shortcut": [
        "ctrl+d",
        "g"
      ],
      "close_keys": [
        "escape"
      ],
      "items": [
        {
          "id": "rhythm_control",
          "type": "submenu",
          "label": "BPM / Judgment",
          "key": "1",
          "shortcut": [
            "ctrl+d",
            "g",
            "1"
          ]
        },
        {
          "id": "spell_visuals",
          "type": "submenu",
          "label": "Spell (solo VFX)",
          "key": "2",
          "shortcut": [
            "ctrl+d",
            "g",
            "2"
          ]
        }
      ]
    },
    "rhythm_control": {
      "scope": "scene",
      "title": "BPM / JUDGMENT",
      "shortcut": [
        "ctrl+d",
        "g",
        "1"
      ],
      "close_keys": [
        "escape"
      ],
      "navigation_keys": {
        "previous": "up",
        "next": "down"
      },
      "adjustment_keys": {
        "decrease": "left",
        "increase": "right"
      },
      "items": [
        {
          "id": "bpm",
          "type": "integer_setting",
          "label": "BPM",
          "source": "rhythm.beat_clock.bpm",
          "minimum": 40,
          "maximum": 240,
          "step": 5
        },
        {
          "id": "perfect_window_ms",
          "type": "integer_setting",
          "label": "Finestra PERFECT",
          "source": "rhythm.judgment.perfect_window_ms",
          "minimum": 5,
          "maximum": "good_window_ms - 5",
          "step": 5
        },
        {
          "id": "good_window_ms",
          "type": "integer_setting",
          "label": "Finestra GOOD",
          "source": "rhythm.judgment.good_window_ms",
          "minimum": "perfect_window_ms + 5",
          "maximum": "min(120, strict_half_beat_slot_gap_cap)",
          "step": 5
        },
        {
          "id": "bpm_enabled",
          "type": "toggle_action",
          "label": "Vincolo BPM",
          "source": "runtime.rhythm.beat_clock.enabled",
          "key": "0"
        }
      ]
    },
    "spell_visuals": {
      "scope": "scene",
      "title": "Spell // solo VFX",
      "shortcut": [
        "ctrl+d",
        "g",
        "2"
      ],
      "close_keys": [
        "escape"
      ],
      "items": [
        {
          "id": "black_hole_cast",
          "type": "info",
          "label": "A / SHIFT+A — BLACK HOLE: CAST VISIVO"
        },
        {
          "id": "white_hole_cast",
          "type": "info",
          "label": "S / SHIFT+S — WHITE HOLE: CAST VISIVO"
        },
        {
          "id": "gravity_star_cast",
          "type": "info",
          "label": "D / SHIFT+D — STAR: CAST VISIVO"
        },
        {
          "id": "effects_disabled",
          "type": "info",
          "label": "NESSUN EFFETTO SU MAPPA, OGGETTI, LUCE O FISICA"
        }
      ]
    }
  },
  "mutually_exclusive": true,
  "gameplay_shortcut_prefix": {
    "keys": [
      "ctrl+d"
    ],
    "timeout": "until_next_key",
    "commands": {
      "g": "gameplay_menu"
    }
  }
}
