{
  "format_version": 1,
  "shortcut_prefix": {
    "keys": [
      "ctrl+p"
    ],
    "timeout": "until_next_key",
    "commands": {
      "m": "scene_select",
      "r": "scene_reload",
      "c": "frame_copy"
    }
  },
  "global_actions": {
    "scene_reload": {
      "type": "action",
      "label": "Ricarica scena",
      "shortcut": [
        "ctrl+p",
        "r"
      ]
    },
    "frame_copy": {
      "type": "action",
      "label": "Copia frame",
      "shortcut": [
        "ctrl+p",
        "c"
      ],
      "output": "clipboard_image/png"
    }
  },
  "menus": {
    "system_settings": {
      "scope": "system",
      "title": "System Settings",
      "shortcut": [
        "ctrl+p"
      ],
      "close_keys": [
        "escape"
      ],
      "items": [
        {
          "id": "scene_select",
          "type": "submenu",
          "label": "Cambia scena",
          "key": "m",
          "shortcut": [
            "ctrl+p",
            "m"
          ]
        },
        {
          "id": "scene_reload",
          "type": "action",
          "label": "Ricarica scena",
          "key": "r",
          "shortcut": [
            "ctrl+p",
            "r"
          ]
        },
        {
          "id": "frame_copy",
          "type": "action",
          "label": "Copia frame",
          "key": "c",
          "shortcut": [
            "ctrl+p",
            "c"
          ]
        }
      ]
    },
    "scene_select": {
      "scope": "system",
      "title": "Cambia scena",
      "close_keys": [
        "escape"
      ],
      "items": [
        {
          "id": "test-gameplay-rhythm-crypto",
          "type": "scene_option",
          "label": "Test gameplay rhythm crypto",
          "key": "1",
          "scene": "res://scenes/test-gameplay-rhythm-crypto.tscn"
        }
      ]
    },
    "gameplay_prefix": {
      "scope": "scene",
      "title": "Debug Gameplay",
      "shortcut": [
        "ctrl+d"
      ],
      "close_keys": [
        "escape"
      ],
      "items": [
        {
          "id": "gameplay_menu",
          "type": "submenu",
          "label": "Gameplay",
          "key": "g",
          "shortcut": [
            "ctrl+d",
            "g"
          ]
        }
      ]
    },
    "gameplay_menu": {
      "scope": "scene",
      "title": "Gameplay",
      "shortcut": [
        "ctrl+d",
        "g"
      ],
      "close_keys": [
        "escape"
      ],
      "items": [
        {
          "id": "rhythm_control",
          "type": "submenu",
          "label": "BPM / Judgment",
          "key": "1",
          "shortcut": [
            "ctrl+d",
            "g",
            "1"
          ]
        },
        {
          "id": "spell_features",
          "type": "submenu",
          "label": "Spells Features",
          "key": "2",
          "shortcut": [
            "ctrl+d",
            "g",
            "2"
          ]
        }
      ]
    },
    "spell_features": {
      "scope": "scene",
      "title": "Spells Features",
      "shortcut": [
        "ctrl+d",
        "g",
        "2"
      ],
      "close_keys": [
        "escape"
      ],
      "items": [
        {
          "id": "spell_v1",
          "type": "submenu",
          "label": "V1",
          "key": "1",
          "shortcut": [
            "ctrl+d",
            "g",
            "2",
            "1"
          ]
        }
      ]
    },
    "spell_v1": {
      "scope": "scene",
      "title": "Spell Features V1",
      "shortcut": [
        "ctrl+d",
        "g",
        "2",
        "1"
      ],
      "close_keys": [
        "escape"
      ],
      "items": [
        {
          "id": "spell_physics_enabled",
          "type": "toggle_action",
          "label": "Fisica Spell",
          "key": "1",
          "default": true
        },
        {
          "id": "snap_on_physics_end",
          "type": "toggle_action",
          "label": "Snap a fine fisica",
          "key": "2",
          "default": true
        },
        {
          "id": "snap_during_physics",
          "type": "toggle_action",
          "label": "Snap durante la fisica",
          "key": "3",
          "default": false
        },
        {
          "id": "spell_influence_visualization",
          "type": "toggle_action",
          "label": "Vista delle influenze",
          "key": "4",
          "default": true
        }
      ]
    },
    "rhythm_control": {
      "scope": "scene",
      "title": "BPM / JUDGMENT",
      "shortcut": [
        "ctrl+d",
        "g",
        "1"
      ],
      "close_keys": [
        "escape"
      ],
      "navigation_keys": {
        "previous": "up",
        "next": "down"
      },
      "adjustment_keys": {
        "decrease": "left",
        "increase": "right"
      },
      "items": [
        {
          "id": "bpm",
          "type": "integer_setting",
          "label": "BPM",
          "source": "rhythm.beat_clock.bpm",
          "minimum": 40,
          "maximum": 240,
          "step": 5
        },
        {
          "id": "perfect_window_ms",
          "type": "integer_setting",
          "label": "Finestra PERFECT",
          "source": "rhythm.judgment.perfect_window_ms",
          "minimum": 5,
          "maximum": "good_window_ms - 5",
          "step": 5
        },
        {
          "id": "good_window_ms",
          "type": "integer_setting",
          "label": "Finestra GOOD",
          "source": "rhythm.judgment.good_window_ms",
          "minimum": "perfect_window_ms + 5",
          "maximum": "min(120, strict_half_beat_slot_gap_cap)",
          "step": 5
        },
        {
          "id": "bpm_enabled",
          "type": "toggle_action",
          "label": "Vincolo BPM",
          "source": "runtime.rhythm.beat_clock.enabled",
          "key": "0"
        }
      ]
    }
  },
  "mutually_exclusive": true,
  "gameplay_shortcut_prefix": {
    "keys": [
      "ctrl+d"
    ],
    "timeout": "until_next_key",
    "commands": {
      "g": "gameplay_menu"
    }
  }
}
