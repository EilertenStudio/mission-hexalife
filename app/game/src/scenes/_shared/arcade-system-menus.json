{
  "format_version": 1,
  "shortcut_prefix": {
    "keys": ["ctrl+p"],
    "timeout": "until_next_key",
    "commands": {
      "d": "system_debug",
      "m": "scene_select",
      "r": "scene_reload",
      "c": "frame_copy"
    }
  },
  "menus": {
    "system_debug": {
      "scope": "system",
      "title": "Debug sistema",
      "close_keys": ["escape"],
      "items": [
        { "id": "measured_fps", "type": "read_only", "label": "FPS effettivi", "source": "runtime.measured_fps" },
        {
          "id": "target_fps",
          "type": "integer_setting",
          "label": "Limite FPS",
          "source": "runtime.target_fps",
          "default": 6,
          "minimum": 1,
          "maximum": 30,
          "step": 1,
          "adjustment_keys": { "decrease": ["-", "["], "increase": ["+", "=", "]"] }
        },
        {
          "id": "render_mode",
          "type": "choice_setting",
          "label": "Modalità di resa",
          "source": "runtime.render_mode",
          "default": "half-block",
          "values": ["half-block", "shape-glyph"],
          "cycle_key": "v"
        },
        {
          "id": "frame_pause",
          "type": "toggle_action",
          "label": "Pausa / avvia frame",
          "source": "runtime.frame_paused",
          "key": "p",
          "default": false
        }
      ]
    },
    "scene_select": {
      "scope": "system",
      "title": "Cambia scena",
      "close_keys": ["escape"],
      "items": [
        { "id": "test-visual-grooms", "type": "scene_option", "label": "Test visual grooms", "key": "1", "scene": "test-visual-grooms" },
        { "id": "cryogenic-room", "type": "scene_option", "label": "Sala criogenica", "key": "2", "scene": "cryogenic-room" },
        { "id": "test-gameplay-action-adventure", "type": "scene_option", "label": "Test gameplay action adventure", "key": "3", "scene": "test-gameplay-action-adventure" }
      ]
    }
  },
  "global_actions": {
    "quit": { "keys": ["q", "escape"], "active_when": "menus_closed" }
  },
  "mutually_exclusive": true
}
