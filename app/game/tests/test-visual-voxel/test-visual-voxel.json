    "format_version": 1,
    "id": "test-visual-voxel",
    "subject_type": "scene",
    "name": "Test visual voxel",
    "context_sections": {
      "geometry": "res://tests/test-visual-voxel/test-visual-voxel.json#geometry",
      "materials": "res://tests/test-visual-voxel/test-visual-voxel.json#materials",
